+            </h3>
+            <Timeline items={CV.education} />
+          </section>
+
+          <section aria-labelledby="cv-exp">
+            <h3 className="cv-heading" id="cv-exp">
+              <Glitch>Experience</Glitch>
+            </h3>
+            <Timeline items={CV.experience} />
+          </section>
+        </div>
+      </article>
+    </Level>
+  );
+}
