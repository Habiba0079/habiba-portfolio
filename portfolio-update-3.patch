index 0000000..81dacb2
--- /dev/null
+++ b/src/styles/arcade.css
@@ -0,0 +1,465 @@
+/* ---------- The project arcade ----------
+   Screen and blurb on the left, joystick and buttons on the right, so you can
+   press the controls and watch the screen at the same time. */
+.arcade {
+  position: relative;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 15.5rem;
+  grid-template-areas:
+    "screen controls"
+    "info controls";
+  gap: 1rem 1.5rem;
+  align-items: start;
+  max-width: 1040px;
+  margin-inline: auto;
+  padding: clamp(0.75rem, 2vw, 1.25rem);
+  background: var(--card);
+  border: 4px solid var(--light);
+  box-shadow: 8px 8px 0 var(--shadow);
+}
+.arcade:focus-visible {
+  outline: 3px solid var(--coin);
+  outline-offset: 6px;
+}
+.arcade-screen {
+  grid-area: screen;
+  min-width: 0;
+}
+.arcade-info {
+  grid-area: info;
+  display: grid;
+  gap: 0.5rem;
+  min-width: 0;
+}
+.controls {
+  grid-area: controls;
+  display: grid;
+  align-content: start;
+  justify-items: center;
+  gap: 1.25rem;
+  padding: 1.25rem 1rem;
+  background: #2e2650;
+  border: 4px solid #1c1636;
+}
+@media (max-width: 899px) {
+  .arcade {
+    grid-template-columns: minmax(0, 1fr);
+    grid-template-areas:
+      "screen"
+      "controls"
+      "info";
+  }
+  .controls {
+    grid-template-columns: auto minmax(0, 1fr);
+    justify-items: stretch;
+    align-items: center;
+    gap: 0.75rem 0.5rem;
+    padding: 0.75rem;
+  }
+  .buttons {
+    justify-content: flex-end;
+  }
+  .controls-links {
+    grid-column: 1 / -1;
+    grid-template-columns: 1fr 1fr;
+  }
+}
+
+/* Screen */
+.bezel {
+  padding: clamp(8px, 1.6vw, 16px);
+  background: #0a1226;
+  border: 4px solid #05070f;
+  box-shadow: inset 0 0 0 4px #1b2a4a;
+}
+.screen {
+  position: relative;
+  overflow: hidden;
+  aspect-ratio: 16 / 9;
+  margin-inline: auto;
+  /* never taller than what fits on screen next to the blurb */
+  width: min(100%, calc((100vh - 22rem) * 16 / 9));
+  width: min(100%, calc((100svh - 22rem) * 16 / 9));
+  background: #050b18;
+  border-radius: 10px;
+  touch-action: pan-y;
+  user-select: none;
+}
+@media (max-width: 899px) {
+  .screen {
+    width: 100%;
+    aspect-ratio: 16 / 10;
+  }
+}
+.screen-inner {
+  position: absolute;
+  inset: 0;
+}
+.screen-inner.flick {
+  animation: screen-on 0.3s steps(4);
+}
+@keyframes screen-on {
+  0% { filter: brightness(2.4) contrast(1.5); opacity: 0.4; }
+  50% { filter: brightness(1.5); opacity: 0.85; }
+  100% { filter: none; opacity: 1; }
+}
+.media {
+  position: absolute;
+  inset: 0;
+  background: #050b18;
+}
+.media.dim {
+  filter: brightness(0.4) saturate(0.8);
+}
+.shot {
+  position: absolute;
+  inset: 0;
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain; /* the whole screenshot is always visible */
+}
+.crt {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: repeating-linear-gradient(to bottom, rgba(0, 0, 0, 0) 0 2px, rgba(0, 0, 0, 0.1) 2px 3px);
+  box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.4);
+}
+
+/* Empty slot: a test card */
+.nosignal {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  background: #0b1a33;
+}
+.bars {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 0;
+  height: 72%;
+  opacity: 0.5;
+  background: linear-gradient(
+    90deg,
+    #c8c8c8 0 14.28%,
+    #c8c800 0 28.56%,
+    #00c8c8 0 42.84%,
+    #00c800 0 57.12%,
+    #c800c8 0 71.4%,
+    #c80000 0 85.68%,
+    #0000c8 0 100%
+  );
+}
+.nosignal-box {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  gap: 0.7rem;
+  max-width: 90%;
+  padding: 0.9rem 1.1rem;
+  text-align: center;
+  background: rgba(12, 33, 65, 0.92);
+  border: 4px solid var(--light);
+}
+.nosignal-title {
+  font-family: var(--pixel);
+  font-size: clamp(0.55rem, 1.8vw, 0.8rem);
+  color: var(--light);
+}
+.nosignal-hint {
+  font-family: var(--pixel);
+  font-size: clamp(0.42rem, 1.2vw, 0.55rem);
+  line-height: 1.6;
+  color: var(--star);
+  overflow-wrap: anywhere;
+}
+
+/* Game select */
+.menu {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  align-content: center;
+  justify-items: start;
+  gap: clamp(0.5rem, 1.8vw, 1rem);
+  padding: clamp(0.75rem, 4%, 2.5rem);
+}
+.menu-title {
+  margin: 0;
+  font-family: var(--pixel);
+  font-size: clamp(0.6rem, 1.8vw, 0.95rem);
+  color: var(--headers);
+  text-shadow: 3px 3px 0 #000;
+}
+.menu-list {
+  display: grid;
+  gap: 0.4rem;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+.menu-item {
+  display: flex;
+  align-items: center;
+  gap: 0.8rem;
+  padding: 0.45rem 0.9rem 0.45rem 0.5rem;
+  font-family: var(--pixel);
+  font-size: clamp(0.65rem, 2.2vw, 1.15rem);
+  text-align: left;
+  color: var(--light);
+  background: rgba(12, 33, 65, 0.85);
+  border: 3px solid transparent;
+  cursor: pointer;
+}
+.menu-item[aria-current="true"] {
+  color: var(--coin);
+  border-color: var(--coin);
+}
+.cursor {
+  width: 0;
+  height: 0;
+  border-top: 0.45em solid transparent;
+  border-bottom: 0.45em solid transparent;
+  border-left: 0.7em solid var(--coin);
+  visibility: hidden;
+}
+.menu-item[aria-current="true"] .cursor {
+  visibility: visible;
+}
+.menu-hint {
+  margin: 0;
+  font-family: var(--pixel);
+  font-size: clamp(0.45rem, 1.2vw, 0.6rem);
+  color: var(--star);
+  text-shadow: 2px 2px 0 #000;
+  animation: blink 1.2s steps(2) infinite;
+}
+
+/* Playing */
+.screen-tag,
+.screen-count {
+  position: absolute;
+  top: 10px;
+  padding: 0.4rem 0.55rem;
+  font-family: var(--pixel);
+  font-size: clamp(0.45rem, 1.2vw, 0.6rem);
+  line-height: 1;
+  text-transform: uppercase;
+}
+.screen-tag {
+  left: 10px;
+  color: var(--block-line);
+  background: var(--block);
+  border: 3px solid var(--block-line);
+}
+.screen-count {
+  right: 10px;
+  color: var(--light);
+  background: rgba(12, 33, 65, 0.85);
+  border: 3px solid var(--light);
+}
+.screen-dots {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 10px;
+  display: flex;
+  justify-content: center;
+  gap: 8px;
+}
+.screen-dots i {
+  width: 9px;
+  height: 9px;
+  background: rgba(245, 239, 228, 0.35);
+  border: 2px solid rgba(0, 0, 0, 0.6);
+}
+.screen-dots i.on {
+  background: var(--coin);
+}
+
+/* ---------- Blurb under the screen ---------- */
+.info-head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 0.25rem 1rem;
+}
+.info-title {
+  margin: 0;
+  font-family: var(--pixel);
+  font-weight: 400;
+  font-size: clamp(0.95rem, 2.4vw, 1.35rem);
+  line-height: 1.3;
+  color: var(--headers);
+  text-shadow: 3px 3px 0 var(--shadow);
+}
+.info-status {
+  margin: 0;
+  font-family: var(--pixel);
+  font-size: 0.55rem;
+  text-transform: uppercase;
+  color: var(--star);
+}
+.info-line {
+  margin: 0;
+  font-size: 1.45rem;
+  line-height: 1.2;
+}
+.arcade-info .tags {
+  margin: 0.25rem 0 0;
+}
+.arcade-info .tag {
+  font-size: 0.5rem;
+  padding: 0.4rem 0.5rem;
+}
+
+/* ---------- Controls ---------- */
+.controls-links {
+  display: grid;
+  gap: 0.6rem;
+  width: 100%;
+}
+.controls-links .pixel-link {
+  padding: 0.85rem 0.6rem;
+  font-size: 0.7rem;
+  text-align: center;
+}
+
+/* Joystick */
+.stick {
+  position: relative;
+  width: 9.5rem;
+  height: 9.5rem;
+}
+.stick-base {
+  position: absolute;
+  inset: 1.6rem;
+  display: grid;
+  place-items: center;
+  border-radius: 50%;
+  background: radial-gradient(circle at 35% 30%, #3b3560, #16122e);
+  border: 4px solid #0d0a20;
+}
+.stick-ball {
+  width: 3.2rem;
+  height: 3.2rem;
+  border-radius: 50%;
+  background: radial-gradient(circle at 35% 30%, #ff8a8f, #e5484d 60%, #8f1d24);
+  border: 4px solid #4a0d12;
+  box-shadow: 0 6px 0 rgba(0, 0, 0, 0.35);
+  transition: transform 0.08s;
+}
+.stick[data-tilt="up"] .stick-ball { transform: translate(0, -12px); }
+.stick[data-tilt="down"] .stick-ball { transform: translate(0, 12px); }
+.stick[data-tilt="left"] .stick-ball { transform: translate(-12px, 0); }
+.stick[data-tilt="right"] .stick-ball { transform: translate(12px, 0); }
+.dir {
+  position: absolute;
+  display: grid;
+  place-items: center;
+  width: 2.5rem;
+  height: 2.5rem;
+  padding: 0;
+  background: #1c1636;
+  border: 3px solid #0d0a20;
+  cursor: pointer;
+}
+.dir:hover {
+  background: var(--card);
+}
+.dir:active {
+  transform: translateY(2px);
+}
+.dir-up { top: 0; left: 50%; margin-left: -1.25rem; }
+.dir-down { bottom: 0; left: 50%; margin-left: -1.25rem; }
+.dir-left { left: 0; top: 50%; margin-top: -1.25rem; }
+.dir-right { right: 0; top: 50%; margin-top: -1.25rem; }
+.arrow {
+  width: 0;
+  height: 0;
+  border: 0.5rem solid transparent;
+}
+.dir-up .arrow { border-top: 0; border-bottom: 0.75rem solid var(--light); }
+.dir-down .arrow { border-bottom: 0; border-top: 0.75rem solid var(--light); }
+.dir-left .arrow { border-left: 0; border-right: 0.75rem solid var(--light); }
+.dir-right .arrow { border-right: 0; border-left: 0.75rem solid var(--light); }
+@media (max-width: 899px) {
+  .stick {
+    width: 8.25rem;
+    height: 8.25rem;
+  }
+  .stick-base {
+    inset: 1.4rem;
+  }
+  .stick-ball {
+    width: 2.6rem;
+    height: 2.6rem;
+  }
+  .dir {
+    width: 2.25rem;
+    height: 2.25rem;
+  }
+  .dir-up, .dir-down { margin-left: -1.125rem; }
+  .dir-left, .dir-right { margin-top: -1.125rem; }
+}
+
+/* A and B */
+.buttons {
+  display: flex;
+  align-items: flex-end;
+  justify-content: center;
+  gap: 1.25rem;
+}
+.abtn {
+  display: grid;
+  justify-items: center;
+  gap: 0.6rem;
+  padding: 0;
+  font-family: var(--pixel);
+  font-size: 0.5rem;
+  text-transform: uppercase;
+  color: var(--light);
+  background: none;
+  border: 0;
+  cursor: pointer;
+}
+.abtn-cap {
+  display: grid;
+  place-items: center;
+  width: 3.8rem;
+  height: 3.8rem;
+  border-radius: 50%;
+  font-size: 1rem;
+  color: #fff;
+  border: 4px solid #0d0a20;
+  box-shadow: 0 6px 0 #0d0a20;
+  transition: transform 0.06s, box-shadow 0.06s;
+}
+.abtn--a .abtn-cap {
+  background: radial-gradient(circle at 35% 30%, #ff8a8f, #e5484d 60%, #8f1d24);
+}
+.abtn--b .abtn-cap {
+  color: #5a3a00;
+  background: radial-gradient(circle at 35% 30%, #fff2a8, #ffd84a 60%, #b8860b);
+}
+.abtn:active:not(:disabled) .abtn-cap {
+  transform: translateY(4px);
+  box-shadow: 0 2px 0 #0d0a20;
+}
+.abtn:disabled {
+  opacity: 0.45;
+  cursor: default;
+}
+@media (max-width: 899px) {
+  .abtn-cap {
+    width: 3.3rem;
+    height: 3.3rem;
+  }
+  .buttons {
+    gap: 0.9rem;
+  }
+}
